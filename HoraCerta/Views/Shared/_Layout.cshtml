<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HoraCerta</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/shared/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HoraCerta.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" integrity="" crossorigin="anonymous">
</head>
<body>
    <partial name="_Header" />
    <div class="container-fluid">
        <div class="row">
            @await Html.PartialAsync("_Sidebar")

            <!-- Conteúdo principal: ocupa todo em xs, deslocado em md+ -->
            <main class="col-12 col-md-9 col-lg-10 px-4 py-3 d-flex justify-content-center">
                <div class="w-100 px-4" style="max-width: 1100px;">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
    <partial name="_Footer" />
    <!-- scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/alertas.js" asp-append-version="true"></script>
    <!-- separa responsabilidades -->
    <script src="~/js/temas.js" asp-append-version="true"></script>
    <script src="~/js/sidebar.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
