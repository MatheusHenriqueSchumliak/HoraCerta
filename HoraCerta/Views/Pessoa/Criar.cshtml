@model HoraCerta.Application.ViewModels.Pessoa.PessoaViewModel

@{
    ViewData["Title"] = "Criar Pessoa";
}

<h1>Criar Pessoa</h1>

<form asp-action="Criar" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @await Html.PartialAsync("_Formulario", Model)

    @{
        ViewData["CancelAction"] = "Lista";
    }
    @await Html.PartialAsync("_FormButtons", Model)

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <validation-summary />

    <!-- script externo -->
    <script src="~/js/Pessoa/Criar.js" asp-append-version="true"></script>
    <script src="~/js/alertas.js" asp-append-version="true"></script>

    @if (TempData["AlertaSucesso"] != null)
    {
        <script>
            alertaAviso('@TempData["AlertaSucesso"]');
        </script>
    }
    @if (TempData["AlertaErro"] != null)
    {
        <script>
            alertaAviso('@Html.Raw(TempData["AlertaErro"])');
        </script>
    }
}