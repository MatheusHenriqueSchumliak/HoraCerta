@model HoraCerta.Application.ViewModels.Pessoa.PessoaViewModel

@* Partial contendo apenas os campos (sem <form> nem botões) *@
<div class="col-md-6">
    <label asp-for="Nome" class="form-label"></label>
    <input asp-for="Nome" class="form-control" />
    <span asp-validation-for="Nome" class="text-danger"></span>
</div>
<div class="col-md-6">
    <label asp-for="SobreNome" class="form-label">Sobrenome</label>
    <input asp-for="SobreNome" class="form-control" />
    <span asp-validation-for="SobreNome" class="text-danger"></span>
</div>
<div class="col-md-6">
    <label asp-for="Telefone" class="form-label"></label>
    <input asp-for="Telefone" class="form-control mask-phone" data-mask="phone" />
    <span asp-validation-for="Telefone" class="text-danger"></span>
</div>
<div class="col-md-6">
    <label asp-for="Celular" class="form-label"></label>
    <input asp-for="Celular" class="form-control mask-phone" data-mask="phone" />
    <span asp-validation-for="Celular" class="text-danger"></span>
</div>
<div class="col-md-4">
    <label asp-for="DataNascimento" class="form-label"></label>
    <input asp-for="DataNascimento" class="form-control" type="date" />
    <span asp-validation-for="DataNascimento" class="text-danger"></span>
</div>
<div class="col-md-4">
    <label asp-for="Cpf" class="form-label"></label>
    <input asp-for="Cpf" class="form-control mask-cpf" data-mask="cpf" />
    <span asp-validation-for="Cpf" class="text-danger"></span>
</div>

<h4 class="mt-4">Endereço</h4>
<div class="col-md-4">
    <label asp-for="Endereco.CEP" class="form-label"></label>
    <input asp-for="Endereco.CEP" class="form-control" />
    <span asp-validation-for="Endereco.CEP" class="text-danger" id="cep-error"></span>
</div>
<div class="col-md-8">
    <label asp-for="Endereco.Rua" class="form-label"></label>
    <input asp-for="Endereco.Rua" class="form-control" />
    <span asp-validation-for="Endereco.Rua" class="text-danger"></span>
</div>
<div class="col-md-2">
    <label asp-for="Endereco.Numero" class="form-label"></label>
    <input asp-for="Endereco.Numero" class="form-control" />
    <span asp-validation-for="Endereco.Numero" class="text-danger"></span>
</div>
<div class="col-md-4">
    <label asp-for="Endereco.Bairro" class="form-label"></label>
    <input asp-for="Endereco.Bairro" class="form-control" />
    <span asp-validation-for="Endereco.Bairro" class="text-danger"></span>
</div>
<div class="col-md-4">
    <label asp-for="Endereco.Cidade" class="form-label"></label>
    <input asp-for="Endereco.Cidade" class="form-control" />
    <span asp-validation-for="Endereco.Cidade" class="text-danger"></span>
</div>
<div class="col-md-2">
    <label asp-for="Endereco.Estado" class="form-label"></label>
    <input asp-for="Endereco.Estado" class="form-control" />
    <span asp-validation-for="Endereco.Estado" class="text-danger"></span>
</div>
<div class="col-md-12">
    <label asp-for="Endereco.Complemento" class="form-label"></label>
    <input asp-for="Endereco.Complemento" class="form-control" />
    <span asp-validation-for="Endereco.Complemento" class="text-danger"></span>
</div>
<div class="col-md-12">
    <label asp-for="Observacao" class="form-label">Observação</label>
    <textarea asp-for="Observacao" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Observacao" class="text-danger"></span>
</div>